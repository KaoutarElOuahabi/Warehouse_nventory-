# If your hosting control panel points the website's document root at this
# top-level folder instead of at public/, this blocks direct web access to
# everything except the public/ folder. (Ideally, point the document root
# AT public/ instead — see the deployment guide.)
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
